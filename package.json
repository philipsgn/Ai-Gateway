{
  "name": "enterprise-ai-access-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise AI Account & Access Management System - Phase 1 Core Foundation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@enterprise-ai/web",
    "dev:api": "npm run start --workspace=@enterprise-ai/api",
    "dev:web": "npm run dev --workspace=@enterprise-ai/web",
    "build": "npm run build --workspace=@enterprise-ai/web",
    "typecheck": "npm run typecheck --workspace=@enterprise-ai/web",
    "lint": "npm run lint --workspace=@enterprise-ai/web",
    "test": "npm run test --workspace=apps/api",
    "test:lease": "npm run test --workspace=apps/api",
    "db:generate": "npm run db:generate --workspace=@enterprise-ai/api",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "npm run seed --workspace=@enterprise-ai/api",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.mts",
    "verify:web-prod-bundle": "node scripts/verify-web-prod-bundle.mjs",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.4.4",
    "typescript": "^5.4.5"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
