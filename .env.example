# ==============================================================================
# Enterprise AI Access Management System — Track A (Real MVP Vertical Slice)
# Phase 17: MVP Real Auth Slice
# ==============================================================================

# 1. PostgreSQL Database (Neon / Supabase managed connection string)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Google Cloud OAuth 2.0 Credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   Local: http://localhost:3000/api/auth/callback/google
#   Vercel: https://<your-deployment>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 3. NextAuth / Auth.js v5 Secret & URL
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-character-secret
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-random-32-character-secret

# 4. Upstash Serverless Redis (for Login Rate-Limiting)
# Create at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 5. Root Administrator Identity
# Set your primary Google account email to automatically receive ROOT_ADMIN role
ROOT_ADMIN_EMAIL=admin@yourcompany.com
